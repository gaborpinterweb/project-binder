# Fly.io secrets — set with: fly secrets set KEY=value …
# Do not commit real secrets. Rebuild after changing VITE_* (Docker build-args in fly.toml).

# Public site URL (verify/reset email links). Use your Fly HTTPS domain.
APP_URL=https://project-binder.fly.dev

# PocketBase superuser (created/updated on each boot via upsert)
PB_ADMIN_EMAIL=admin@yourdomain.com
PB_ADMIN_PASSWORD=

# Resend (optional locally; recommended in cloud)
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Project Binder

# Docker build-args — Commercial defaults are in fly.toml [build.args].
# Community: set VITE_COMMERCIAL empty / remove it and rebuild.
# Polar checkout/portal (set in fly.toml or pass --build-arg):
#   VITE_POLAR_CHECKOUT_URL=https://…   # Checkout Link with require_billing_address
#   VITE_POLAR_PORTAL_URL=https://polar.sh/<org-slug>/portal
# Optional feedback / Contact us link (default https://projectbinder.app/feedback):
#   VITE_FEEDBACK_URL=https://…

# Polar webhook signing secret (runtime; must match Polar webhook endpoint secret):
# POLAR_WEBHOOK_SECRET=
# Webhook endpoint: https://cloud.projectbinder.app/api/polar-webhook

# Runtime (set in fly.toml [env]; usually leave alone)
# PORT=8090
# DATA_DIR=/data
