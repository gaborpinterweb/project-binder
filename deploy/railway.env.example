# Railway service variables (Variables tab). Do not commit real secrets.
# Rebuild after changing VITE_* (they are Docker build-args).

# Public site URL (verify/reset email links). Use your Railway HTTPS domain.
APP_URL=https://your-app.up.railway.app

# PocketBase superuser (created/updated on each boot via upsert)
PB_ADMIN_EMAIL=admin@yourdomain.com
PB_ADMIN_PASSWORD=

# Resend (optional locally; recommended in cloud)
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Project Binder

# Docker build-args — set as Railway Variables and pass into build, or
# configure Dockerfile build args in the Railway UI.
# Community (default): leave unset / empty.
# Commercial hosted instance:
#   VITE_COMMERCIAL=true
#   VITE_LS_CHECKOUT_URL=https://…   # Lemon Squeezy checkout
#   VITE_LS_PORTAL_URL=https://…     # Lemon Squeezy customer portal

# Runtime (usually set by Railway)
# PORT=          # Railway injects this
# DATA_DIR=/data # volume mount path
