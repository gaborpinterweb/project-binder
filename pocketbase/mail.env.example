# Copy to pocketbase/mail.env and fill in. Never commit mail.env.
# Used by: npm run pb:mail  (also auto-applied when npm start finds this file)

RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Project Binder
APP_URL=http://127.0.0.1:8090

# Superuser created at first PocketBase install (http://127.0.0.1:8090/_/)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
